# Copy this file to .env and fill in your own values.

# Django
SECRET_KEY=
# Set to False in production. Defaults to True (local dev) if unset.
DEBUG=True
# Comma-separated list of allowed hosts in production, e.g.
# example.com,www.example.com. Defaults to "*" (fine for local dev only).
ALLOWED_HOSTS=*

# Email (used for appointment confirmation mails)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AWS (only needed for the voice-to-text symptom feature)
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
MY_REGION=
BUCKET_NAME=
